  "narrative": {
    "northStar": "Лабораторный журнал",
    "overview": "Это рабочая среда кафедры, в которой учёт читается как последовательность наблюдений, а не как набор карточек. Холодный белый лист, чернильный синий, спектральный зелёный и янтарь риска создают спокойный, точный и проверяемый контур для ежедневных операций.\n\nСистема плотная, но не тесная: иерархия строится на реестровых линиях, табах, тонких измерительных метках и ясных статусах. Точная композиция обзорной панели не является обязательной для каждого экрана; обязательны её дисциплина, контраст приоритетов и ощущение журнальной записи.",
    "keyCharacteristics": ["Холодная бумажная поверхность и чернильная навигация.", "Реестровая плотность вместо декоративной карточной сетки.", "Цвет сообщает состояние и доступность действия, а не украшает интерфейс.", "Квадратная, измерительная геометрия с редкими углами в 2px."],
    "rules": [
      { "name": "The Status-Only Accent Rule", "body": "Зелёный и янтарный несут только смысл состояния: готовность, контроль или риск. Не используйте их как произвольные фирменные заливки.", "section": "colors" },
      { "name": "The Ink-on-Paper Rule", "body": "Рабочая область остаётся светлой и бумажной; тёмный синий предназначен для навигационной опоры и управляемых действий.", "section": "colors" },
      { "name": "The Scan-First Type Rule", "body": "Не вводите декоративные гарнитуры или сверхкрупные надписи: типографика должна помогать сверять записи за один взгляд.", "section": "typography" },
      { "name": "The Ruled-Surface Rule", "body": "Сначала создавайте глубину границей и тональной поверхностью; тень допустима только для листа, который действительно лежит над контекстом.", "section": "elevation" }
    ],
    "dos": ["Do сохраняйте холодный бумажный фон, белые листы и реестровые границы для операционных данных.", "Do используйте постоянную 254px rail-навигацию там, где разделов много и пользователь работает с ними регулярно; для иных сценариев переносите язык навигации, а не обязательно её композицию.", "Do показывайте статус одновременно текстом и 7px маркером, сохраняя его семантику.", "Do обеспечивайте focus-visible outline 3px с offset 2px и сокращайте анимации при reduced motion."],
    "donts": ["Don't заменяйте журнальную структуру россыпью одинаковых скруглённых карточек.", "Don't применяйте зелёный или янтарный как декоративный акцент вне готовности, контроля и риска.", "Don't добавляйте тяжёлые тени или большие скругления: глубина должна оставаться редкой и функциональной.", "Don't делайте цвет единственным носителем статуса или доступности действия."]
  }
}
